# Public HTTPS domain. Configure DNS and a certificate on your Azure gateway
# (Application Gateway, Front Door, or another TLS proxy) before using it.
API_BASE=https://shop.example.com/api
FRONTEND_BASE_URL=https://shop.example.com
CORS_ORIGINS=https://shop.example.com

# Production PostgreSQL/RDS connection string.
DATABASE_URL=postgresql://db_user:db_password@db-host:5432/db_name
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=120
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Shop <no-reply@example.com>
SMTP_USE_TLS=true

# Azure Blob Storage (production only).
STORAGE_BACKEND=azure
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=replace-me;AccountKey=replace-me;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=products
AZURE_BLOB_PUBLIC_URL=

# Optional Slack-compatible incoming webhook. Leave blank to disable alerts.
ALERT_WEBHOOK_URL=
HEALTHCHECK_INTERVAL_SECONDS=60

# Keep backup archives for this many days. Configure the schedule on one
# designated host with scripts/install-backup-cron.sh.
BACKUP_RETENTION_DAYS=14
IMAGE_TAG=latest
