# Public URL used by the browser. Keep the /api suffix from nginx.conf.
API_BASE=https://app.example.com/api

# Amazon RDS PostgreSQL connection string.
DATABASE_URL=postgresql://app_user:replace_me@db.example.ap-southeast-1.rds.amazonaws.com:5432/app_db

# Replace with a long, randomly generated value before deployment.
JWT_SECRET=replace_with_a_random_secret
JWT_EXPIRE_MINUTES=120

# Amazon S3. Authentication comes from the EC2/ECS IAM role.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=replace_with_your_bucket_name

# Optional: use a CloudFront/custom URL for public objects, or leave empty.
AWS_S3_PUBLIC_URL=

# Leave empty for Amazon S3. Set only for another S3-compatible service.
AWS_S3_ENDPOINT_URL=
