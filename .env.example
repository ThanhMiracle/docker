# Public URL used by the browser. Jenkins replaces this with the ALB URL.
# This fallback is useful for a manual deployment on the Docker host.
API_BASE=/api

# Production PostgreSQL/RDS connection string.
DATABASE_URL=postgresql://db_user:db_password@db-host:5432/db_name

# Generate a long random value, for example: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=120

# Production S3 configuration. Prefer an EC2 IAM role over access keys.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=replace-with-production-bucket
AWS_S3_PUBLIC_URL=
AWS_S3_ENDPOINT_URL=

# Leave these empty when the production host has an EC2 IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional for manual deployments. Jenkins overrides this with BUILD_NUMBER.
IMAGE_TAG=latest
