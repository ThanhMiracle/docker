# Public URL used by the browser. Jenkins replaces this with the ALB URL.
# This fallback is useful for a manual deployment on the Docker host.
API_BASE=/api

# Production PostgreSQL/RDS connection string.
DATABASE_URL=postgresql://db_user:db_password@db-host:5432/db_name

# Generate a long random value, for example: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=https://shop.example.com
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# Account and outbound-email configuration.
ADMIN_EMAIL=admin@example.com
FRONTEND_BASE_URL=https://shop.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Shop <no-reply@example.com>
SMTP_USE_TLS=true

# Azure Blob Storage: use the VM/Container App's existing managed identity.
STORAGE_BACKEND=azure
AZURE_STORAGE_ACCOUNT_URL=https://your-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER=products
# Leave blank for system-assigned identity; set the client ID for user-assigned identity.
AZURE_CLIENT_ID=
# Use an existing container by default; enable only if the identity can create containers.
AZURE_STORAGE_AUTO_CREATE_CONTAINER=false
# Optional fallback when not using an account URL. Keep connection strings in secrets.
AZURE_STORAGE_CONNECTION_STRING=
# Optional public CDN/container base URL; otherwise private blobs are served by the API.
AZURE_BLOB_PUBLIC_URL=
AZURE_BLOB_PROXY_URL=/api/files/images

# Optional Slack-compatible incoming webhook for the production health monitor.
ALERT_WEBHOOK_URL=
HEALTHCHECK_INTERVAL_SECONDS=60
BACKUP_RETENTION_DAYS=14

# Optional for manual deployments. Jenkins overrides this with BUILD_NUMBER.
IMAGE_TAG=latest
